{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contambench.local/schemas/request_trace.schema.json",
  "title": "ContamBench reference-harness request trace row",
  "type": "object",
  "required": [
    "request_id",
    "prompt_type",
    "contamination_ratio",
    "arrival_rate",
    "num_clients",
    "success"
  ],
  "properties": {
    "request_id": { "type": "string" },
    "client_id": { "type": "integer" },
    "trial": { "type": "integer" },
    "config_id": { "type": "string" },
    "timestamp_start": { "type": "number" },
    "timestamp_first_token": { "type": ["number", "null"] },
    "timestamp_end": { "type": "number" },
    "prompt_type": { "type": "string", "enum": ["benign", "adversarial"] },
    "contamination_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
    "arrival_rate": { "type": "number" },
    "arrival_model": { "type": "string" },
    "num_clients": { "type": "integer" },
    "success": { "type": "boolean" },
    "http_status": { "type": ["integer", "null"] },
    "input_tokens": { "type": ["integer", "null"] },
    "output_tokens": { "type": "integer" },
    "ttft_ms": { "type": ["number", "null"] },
    "tbt_ms": { "type": ["number", "null"] },
    "latency_ms": { "type": ["number", "null"] },
    "decode_residency_ms": { "type": ["number", "null"] },
    "finish_reason": { "type": ["string", "null"] },
    "error": { "type": ["string", "null"] },
    "pair_index": { "type": "integer" },
    "prompt_id": { "type": "integer" },
    "model": { "type": ["string", "null"] },
    "input_text": { "type": "string" },
    "output_text": { "type": "string" },
    "max_tokens": { "type": ["integer", "null"] }
  }
}
